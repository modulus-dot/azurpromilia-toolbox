+void MenuCommon::AzurAutoSave(RenderMenuContext& ctx)
+{
+    using namespace azur;
+    const double interval = _isVisible ? 400.0 : 1500.0;
+    if (ctx.now - lastCheck < interval)
+        return;
+    lastCheck = ctx.now;
+
+    std::string snapshot = ctx.config->SnapshotIni();
+    if (lastSnapshot.empty())
+    {
+        // First call only records a baseline, so nothing is written at startup
+        lastSnapshot = std::move(snapshot);
+        return;
+    }
+
+    if (snapshot == lastSnapshot)
+    {
+        dirtySince = -1.0;
+        return;
+    }
+
+    if (dirtySince < 0.0)
+        dirtySince = ctx.now;
+
+    // Wait for sliders and text fields to be released, at most 3 seconds
+    const bool editing = ImGui::GetCurrentContext() != nullptr && ImGui::IsAnyItemActive();
+    if (editing && ctx.now - dirtySince < 3000.0)
+        return;
+
+    saveFailed = !ctx.config->SaveIni();
+    lastSnapshot = std::move(snapshot);
+    dirtySince = -1.0;
+    savedAt = ctx.now;
+    LOG_INFO("Azur autosave: settings {}", saveFailed ? "could NOT be written" : "written");
+}
