diff --git a/b/OptiScaler/framegen/xefg/compat_factory.h b/b/OptiScaler/framegen/xefg/compat_factory.h
new file mode 100644
index 0000000..19af480
--- /dev/null
+++ b/b/OptiScaler/framegen/xefg/compat_factory.h
@@ -0,0 +1,87 @@
+#pragma once
+#include <dxgi1_5.h>
+#include <wrl/client.h>
+#include <atomic>
+
+namespace modulus::graphics {
+inline thread_local bool creatingXeFGSwapChain = false;
+struct ScopedXeFGSwapChain {
+    bool previous = creatingXeFGSwapChain;
+    ScopedXeFGSwapChain() { creatingXeFGSwapChain = true; }
+    ~ScopedXeFGSwapChain() { creatingXeFGSwapChain = previous; }
+};
+// Used ONLY by the XeFG internal factory, never by the game's DX11 swap chain.
+// XXMI exposes native SwapChain3 but rejects SwapChain4 on its old wrapper.
+// Obtain a real interface through COM instead of casting that old vtable.
+template<class T> inline void ResolveFrameGenSwapChain(T** chain) {
+    if (!chain || !*chain) return;
+    Microsoft::WRL::ComPtr<IDXGISwapChain4> fourth;
+    Microsoft::WRL::ComPtr<IDXGISwapChain3> third;
+    if (FAILED((*chain)->QueryInterface(IID_PPV_ARGS(&third))) || !third) return;
+    if (FAILED(third->QueryInterface(IID_PPV_ARGS(&fourth))) || !fourth) return;
+    Microsoft::WRL::ComPtr<T> replacement;
+    if (FAILED(fourth.As(&replacement))) return;
+    if (replacement.Get() == *chain) return;
+    (*chain)->Release();
+    *chain = replacement.Detach();
+}
+
+class FrameGenFactory final : public IDXGIFactory2 {
+    std::atomic<ULONG> references_{1};
+    Microsoft::WRL::ComPtr<IDXGIFactory2> real_;
+public:
+    explicit FrameGenFactory(IDXGIFactory2* factory) : real_(factory) {}
+    HRESULT STDMETHODCALLTYPE QueryInterface(REFIID id, void** out) override {
+        if (!out) return E_POINTER;
+        *out = nullptr;
+        if (id == __uuidof(IUnknown) || id == __uuidof(IDXGIObject) ||
+            id == __uuidof(IDXGIFactory) || id == __uuidof(IDXGIFactory1) || id == __uuidof(IDXGIFactory2)) {
+            *out = static_cast<IDXGIFactory2*>(this); AddRef(); return S_OK;
+        }
+        return real_->QueryInterface(id, out);
+    }
+    ULONG STDMETHODCALLTYPE AddRef() override { return ++references_; }
+    ULONG STDMETHODCALLTYPE Release() override { const auto n = --references_; if (!n) delete this; return n; }
+    HRESULT STDMETHODCALLTYPE SetPrivateData(REFGUID a, UINT b, const void* c) override { return real_->SetPrivateData(a,b,c); }
+    HRESULT STDMETHODCALLTYPE SetPrivateDataInterface(REFGUID a, const IUnknown* b) override { return real_->SetPrivateDataInterface(a,b); }
+    HRESULT STDMETHODCALLTYPE GetPrivateData(REFGUID a, UINT* b, void* c) override { return real_->GetPrivateData(a,b,c); }
+    HRESULT STDMETHODCALLTYPE GetParent(REFIID a, void** b) override { return real_->GetParent(a,b); }
+    HRESULT STDMETHODCALLTYPE EnumAdapters(UINT a, IDXGIAdapter** b) override { return real_->EnumAdapters(a,b); }
+    HRESULT STDMETHODCALLTYPE MakeWindowAssociation(HWND a, UINT b) override { return real_->MakeWindowAssociation(a,b); }
+    HRESULT STDMETHODCALLTYPE GetWindowAssociation(HWND* a) override { return real_->GetWindowAssociation(a); }
+    HRESULT STDMETHODCALLTYPE CreateSwapChain(IUnknown* a, DXGI_SWAP_CHAIN_DESC* b, IDXGISwapChain** c) override {
+        ScopedXeFGSwapChain scope;
+        const auto hr = real_->CreateSwapChain(a,b,c); if (SUCCEEDED(hr)) ResolveFrameGenSwapChain(c); return hr;
+    }
+    HRESULT STDMETHODCALLTYPE CreateSoftwareAdapter(HMODULE a, IDXGIAdapter** b) override { return real_->CreateSoftwareAdapter(a,b); }
+    HRESULT STDMETHODCALLTYPE EnumAdapters1(UINT a, IDXGIAdapter1** b) override { return real_->EnumAdapters1(a,b); }
+    BOOL STDMETHODCALLTYPE IsCurrent() override { return real_->IsCurrent(); }
+    BOOL STDMETHODCALLTYPE IsWindowedStereoEnabled() override { return real_->IsWindowedStereoEnabled(); }
+    HRESULT STDMETHODCALLTYPE CreateSwapChainForHwnd(IUnknown* a, HWND b, const DXGI_SWAP_CHAIN_DESC1* c,
+        const DXGI_SWAP_CHAIN_FULLSCREEN_DESC* d, IDXGIOutput* e, IDXGISwapChain1** f) override {
+        ScopedXeFGSwapChain scope;
+        const auto hr = real_->CreateSwapChainForHwnd(a,b,c,d,e,f); if (SUCCEEDED(hr)) ResolveFrameGenSwapChain(f); return hr;
+    }
+    HRESULT STDMETHODCALLTYPE CreateSwapChainForCoreWindow(IUnknown* a, IUnknown* b, const DXGI_SWAP_CHAIN_DESC1* c,
+        IDXGIOutput* d, IDXGISwapChain1** e) override {
+        const auto hr = real_->CreateSwapChainForCoreWindow(a,b,c,d,e); if (SUCCEEDED(hr)) ResolveFrameGenSwapChain(e); return hr;
+    }
+    HRESULT STDMETHODCALLTYPE GetSharedResourceAdapterLuid(HANDLE a, LUID* b) override { return real_->GetSharedResourceAdapterLuid(a,b); }
+    HRESULT STDMETHODCALLTYPE RegisterStereoStatusWindow(HWND a, UINT b, DWORD* c) override { return real_->RegisterStereoStatusWindow(a,b,c); }
+    HRESULT STDMETHODCALLTYPE RegisterStereoStatusEvent(HANDLE a, DWORD* b) override { return real_->RegisterStereoStatusEvent(a,b); }
+    void STDMETHODCALLTYPE UnregisterStereoStatus(DWORD a) override { real_->UnregisterStereoStatus(a); }
+    HRESULT STDMETHODCALLTYPE RegisterOcclusionStatusWindow(HWND a, UINT b, DWORD* c) override { return real_->RegisterOcclusionStatusWindow(a,b,c); }
+    HRESULT STDMETHODCALLTYPE RegisterOcclusionStatusEvent(HANDLE a, DWORD* b) override { return real_->RegisterOcclusionStatusEvent(a,b); }
+    void STDMETHODCALLTYPE UnregisterOcclusionStatus(DWORD a) override { real_->UnregisterOcclusionStatus(a); }
+    HRESULT STDMETHODCALLTYPE CreateSwapChainForComposition(IUnknown* a, const DXGI_SWAP_CHAIN_DESC1* b,
+        IDXGIOutput* c, IDXGISwapChain1** d) override {
+        const auto hr = real_->CreateSwapChainForComposition(a,b,c,d); if (SUCCEEDED(hr)) ResolveFrameGenSwapChain(d); return hr;
+    }
+};
+
+inline Microsoft::WRL::ComPtr<IDXGIFactory2> MakeFrameGenFactory(IDXGIFactory2* original) {
+    Microsoft::WRL::ComPtr<IDXGIFactory2> result;
+    if (original) result.Attach(new FrameGenFactory(original));
+    return result;
+}
+}
diff --git a/b/OptiScaler/framegen/xefg/xefg_present_stats.h b/b/OptiScaler/framegen/xefg/xefg_present_stats.h
new file mode 100644
index 0000000..ca9428f
--- /dev/null
+++ b/b/OptiScaler/framegen/xefg/xefg_present_stats.h
@@ -0,0 +1,96 @@
+#pragma once
+
+#include <chrono>
+#include <cstdint>
+#include <mutex>
+
+namespace modulus::graphics
+{
+struct XeFGPresentSnapshot
+{
+    bool available = false;
+    bool enabled = false;
+    int queryResult = 0;
+    int generationResult = 0;
+    uint32_t submittedFrames = 0;
+    double renderedFps = 0.0;
+    double submittedFps = 0.0;
+};
+
+// SDK submission counts measure queued frames. Scanout requires a display trace.
+class XeFGPresentStats
+{
+  public:
+    using Clock = std::chrono::steady_clock;
+
+    void Record(void* context, int queryResult, bool enabled, int generationResult, uint32_t submittedFrames,
+                Clock::time_point now = Clock::now())
+    {
+        std::lock_guard lock(mutex_);
+        if (context != context_ || queryResult < 0 || enabled != snapshot_.enabled)
+            ResetWindow(now);
+        context_ = context;
+        snapshot_.available = context != nullptr && queryResult >= 0;
+        snapshot_.queryResult = queryResult;
+        snapshot_.enabled = enabled;
+        snapshot_.generationResult = generationResult;
+        snapshot_.submittedFrames = submittedFrames;
+        if (!snapshot_.available)
+            return;
+
+        if (!windowStarted_)
+        {
+            ResetWindow(now);
+            windowStarted_ = true;
+            return;
+        }
+
+        ++renderedFrames_;
+        submittedFrames_ += submittedFrames;
+        const double seconds = std::chrono::duration<double>(now - windowStart_).count();
+        if (seconds >= 0.5)
+        {
+            snapshot_.renderedFps = renderedFrames_ / seconds;
+            snapshot_.submittedFps = submittedFrames_ / seconds;
+            windowStart_ = now;
+            renderedFrames_ = 0;
+            submittedFrames_ = 0;
+        }
+    }
+
+    XeFGPresentSnapshot Read()
+    {
+        std::lock_guard lock(mutex_);
+        return snapshot_;
+    }
+
+    void Reset()
+    {
+        std::lock_guard lock(mutex_);
+        context_ = nullptr;
+        snapshot_ = {};
+        ResetWindow(Clock::now());
+    }
+
+  private:
+    void ResetWindow(Clock::time_point now)
+    {
+        windowStart_ = now;
+        windowStarted_ = false;
+        renderedFrames_ = 0;
+        submittedFrames_ = 0;
+        snapshot_.renderedFps = 0.0;
+        snapshot_.submittedFps = 0.0;
+    }
+
+    std::mutex mutex_;
+    void* context_ = nullptr;
+    XeFGPresentSnapshot snapshot_;
+    Clock::time_point windowStart_ {};
+    bool windowStarted_ = false;
+    uint64_t renderedFrames_ = 0;
+    uint64_t submittedFrames_ = 0;
+};
+
+inline XeFGPresentStats xeFGPresentStats;
+} // namespace modulus::graphics
