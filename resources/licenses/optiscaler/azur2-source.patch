+             Col(0.20f, 0.42f, 0.86f), Col(0.40f, 0.62f, 1.00f), Col(1.00f, 1.00f, 1.00f), Col(0.95f, 0.78f, 0.42f),
+             Col(0.94f, 0.97f, 1.00f), Col(0.60f, 0.70f, 0.88f) };
+}
+
+// Four-point star: centre diamond plus four rays
+static void Star(ImDrawList* dl, ImVec2 c, float r, ImU32 col)
+{
+    const float in = r * 0.26f;
+    const ImVec2 n(c.x, c.y - r), e(c.x + r, c.y), s(c.x, c.y + r), w(c.x - r, c.y);
+    const ImVec2 ne(c.x + in, c.y - in), se(c.x + in, c.y + in), sw(c.x - in, c.y + in), nw(c.x - in, c.y - in);
+    dl->AddTriangleFilled(n, ne, nw, col);
+    dl->AddTriangleFilled(e, se, ne, col);
+    dl->AddTriangleFilled(s, sw, se, col);
+    dl->AddTriangleFilled(w, nw, sw, col);
+    dl->AddQuadFilled(nw, ne, se, sw, col);
+}
