+void MenuCommon::RenderAzurHeader(RenderMenuContext& ctx)
+{
+    using namespace azur;
+    auto& state = ctx.state;
+    auto config = ctx.config;
+    auto& io = ctx.io;
+    const float s = ctx.menuResScale;
+    const bool light = config->LightTheme.value_or_default();
+    const Palette pal = Pal(light);
+
+    ImDrawList* dl = ImGui::GetWindowDrawList();
+    const ImVec2 p = ImGui::GetCursorScreenPos();
+    const float w = std::max(ImGui::GetContentRegionAvail().x, (kNavWidth + kPageWidth) * s + ImGui::GetStyle().ItemSpacing.x);
+    const float h = 84.0f * s;
+    const float r = 16.0f * s;
+    ImFont* font = ImGui::GetFont();
+    const float fs = ImGui::GetFontSize();
+
+    // Banner: parchment to sky blue to lavender, gold edge
+    dl->AddRectFilled(p, ImVec2(p.x + w, p.y + h), pal.bannerA, r);
+    dl->AddRectFilledMultiColor(ImVec2(p.x + r, p.y + 1.0f), ImVec2(p.x + w - r, p.y + h - 1.0f), pal.bannerA, pal.bannerB,
+                                pal.bannerC, pal.bannerD);
+    dl->AddRect(p, ImVec2(p.x + w, p.y + h), pal.bannerBorder, r, 0, 1.5f * s);
+    dl->AddRect(ImVec2(p.x + 4.0f * s, p.y + 4.0f * s), ImVec2(p.x + w - 4.0f * s, p.y + h - 4.0f * s),
+                (pal.bannerBorder & 0x00FFFFFF) | 0x50000000, r - 3.0f * s, 0, 1.0f);
+    dl->AddRectFilledMultiColor(ImVec2(p.x + r, p.y + 1.0f), ImVec2(p.x + w - r, p.y + 3.0f * s), pal.topLine1, pal.topLine2,
+                                pal.topLine2 & 0x00FFFFFF, pal.topLine1 & 0x00FFFFFF);
+
+    static const float sparks[][4] = { { 0.56f, 0.26f, 4.0f, 0 }, { 0.64f, 0.70f, 3.0f, 1 }, { 0.71f, 0.32f, 5.5f, 0 },
+                                       { 0.78f, 0.74f, 3.5f, 1 }, { 0.50f, 0.78f, 2.5f, 0 }, { 0.67f, 0.18f, 2.5f, 1 },
+                                       { 0.60f, 0.50f, 2.0f, 0 }, { 0.46f, 0.40f, 3.0f, 1 } };
+    for (const auto& d : sparks)
+        Star(dl, ImVec2(p.x + w * d[0], p.y + h * d[1]), d[2] * s, d[3] > 0.5f ? pal.sparkle2 : pal.sparkle);
+
+    // Logo: round medallion with a star
+    const ImVec2 c(p.x + 44.0f * s, p.y + h * 0.5f);
+    dl->AddCircleFilled(c, 29.0f * s, light ? Col(1.0f, 1.0f, 1.0f, 0.95f) : Col(0.30f, 0.62f, 1.00f, 0.16f));
+    dl->AddCircle(c, 29.0f * s, pal.gold, 0, 2.0f * s);
+    dl->AddCircle(c, 24.0f * s, (pal.gold & 0x00FFFFFF) | 0x66000000, 0, 1.0f);
+    Star(dl, c, 19.0f * s, light ? Col(0.38f, 0.56f, 0.95f) : Col(0.58f, 0.86f, 1.00f));
+    Star(dl, c, 10.0f * s, light ? Col(0.95f, 0.78f, 0.40f) : Col(0.80f, 0.74f, 1.00f, 0.85f));
+    dl->AddCircleFilled(c, 3.0f * s, Col(1.0f, 1.0f, 1.0f));
+
+    // Title and subtitle
+    const float tx = p.x + 86.0f * s;
+    const float titleSize = fs * 1.75f;
+    dl->AddText(font, titleSize, ImVec2(tx, p.y + 14.0f * s), pal.title, Tr("Azur Promilia - Frame Generation Console"));
+    const std::string sub = StrFmt("%s  |  OptiScaler 10.0 (azur2)  |  %s", Tr("Azur Promilia Edition"),
+                                   Tr("settings save automatically"));
+    dl->AddText(font, fs * 0.95f, ImVec2(tx, p.y + 20.0f * s + titleSize), pal.subtitle, sub.c_str());
+
+    // Badge
+    const char* badge = Tr("Azur Promilia Edition");
+    const ImVec2 bs = font->CalcTextSizeA(fs, FLT_MAX, 0.0f, badge);
+    const ImVec2 b1(p.x + w - 56.0f * s - bs.x - 24.0f * s, p.y + 16.0f * s);
+    const ImVec2 b2(b1.x + bs.x + 24.0f * s, b1.y + bs.y + 10.0f * s);
+    const float br = (b2.y - b1.y) * 0.5f;
+    dl->AddRectFilled(b1, b2, light ? Col(0.36f, 0.54f, 0.92f) : Col(0.30f, 0.55f, 1.0f, 0.85f), br);
+    dl->AddRectFilled(ImVec2(b1.x + 3.0f, b1.y + 2.0f), ImVec2(b2.x - 3.0f, (b1.y + b2.y) * 0.5f), Col(1.0f, 1.0f, 1.0f, 0.18f), br);
+    dl->AddRect(b1, b2, pal.gold, br, 0, 1.5f * s);
+    dl->AddText(font, fs, ImVec2(b1.x + 12.0f * s, b1.y + 5.0f * s), Col(1.0f, 1.0f, 1.0f), badge);
+
+    // Close button
+    const float cb = 28.0f * s;
+    const ImVec2 cp(p.x + w - cb - 14.0f * s, p.y + 14.0f * s);
+    ImGui::SetCursorScreenPos(cp);
+    if (ImGui::InvisibleButton("##azur_close", ImVec2(cb, cb)))
+    {
+        _isVisible = false;
+        io.BackendFlags &= 30;
+        io.ConfigFlags = ImGuiConfigFlags_NoMouse | ImGuiConfigFlags_NoMouseCursorChange | ImGuiConfigFlags_NoKeyboard;
+        _showMipmapCalcWindow = false;
+        _showHudlessWindow = false;
+        io.MouseDrawCursor = false;
+        io.WantCaptureKeyboard = false;
+        io.WantCaptureMouse = false;
+    }
+    const bool closeHover = ImGui::IsItemHovered();
+    dl->AddCircleFilled(ImVec2(cp.x + cb * 0.5f, cp.y + cb * 0.5f), cb * 0.5f,
+                        closeHover ? (light ? Col(0.36f, 0.54f, 0.92f) : Col(1.0f, 1.0f, 1.0f, 0.20f))
+                                   : (light ? Col(1.0f, 1.0f, 1.0f, 0.9f) : Col(1.0f, 1.0f, 1.0f, 0.08f)));
+    dl->AddCircle(ImVec2(cp.x + cb * 0.5f, cp.y + cb * 0.5f), cb * 0.5f, pal.gold, 0, 1.2f * s);
+    const float m = 9.0f * s;
+    const ImU32 xcol = closeHover ? Col(1.0f, 1.0f, 1.0f) : pal.title;
+    dl->AddLine(ImVec2(cp.x + m, cp.y + m), ImVec2(cp.x + cb - m, cp.y + cb - m), xcol, 2.0f * s);
+    dl->AddLine(ImVec2(cp.x + cb - m, cp.y + m), ImVec2(cp.x + m, cp.y + cb - m), xcol, 2.0f * s);
+
+    // Status pills
+    std::vector<Pill> pills;
+    const bool fgEnabled = config->FGEnabled.value_or_default();
+    const FGOutput fgOut = state.activeFgOutput;
+    const bool fgPath = fgOut != FGOutput::NoFG;
+    const auto measured = modulus::graphics::xeFGPresentStats.Read();
+
+    const ImU32 green = Col(0.25f, 0.78f, 0.55f), grey = Col(0.62f, 0.66f, 0.74f), amber = Col(0.98f, 0.66f, 0.25f),
+                blue = Col(0.36f, 0.58f, 0.96f), red = Col(0.95f, 0.38f, 0.40f);
+
+    if (fgPath && fgEnabled)
+        pills.push_back({ Tr("Frame Gen"), Tr("Running"), green });
+    else if (fgPath)
+        pills.push_back({ Tr("Frame Gen"), Tr("Off (toggle with the FG key)"), grey });
+    else
+        pills.push_back({ Tr("Frame Gen"), Tr("Not configured"), amber });
+
+    const char* outName = fgOut == FGOutput::XeFG    ? "XeFG"
+                          : fgOut == FGOutput::FSRFG ? "FSR FG"
+                          : fgOut == FGOutput::DLSSG ? "DLSS-G"
+                                                     : "-";
+    pills.push_back({ Tr("Output"), outName, blue });
+
+    if (fgOut == FGOutput::XeFG)
+        pills.push_back({ Tr("Multiplier"), StrFmt("%dx", config->FGXeFGInterpolationCount.value_or_default() + 1), blue });
+
+    if (measured.available && measured.enabled && measured.renderedFps > 0.5)
+        pills.push_back({ Tr("Measured"), StrFmt("%.0f -> %.0f FPS", measured.renderedFps, measured.submittedFps), green });
+
+    pills.push_back({ Tr("Upscaler"), ctx.currentFeature != nullptr ? ctx.currentFeature->Name() : std::string("-"), blue });
+    pills.push_back({ "NR", config->DlssNrEnabled.value_or_default() ? Tr("On") : Tr("Off"),
+                      config->DlssNrEnabled.value_or_default() ? green : grey });
+
+    if (saveFailed)
+        pills.push_back({ Tr("Settings"), Tr("Save failed (folder read-only?)"), red });
+    else if (dirtySince >= 0.0)
+        pills.push_back({ Tr("Settings"), Tr("Saving..."), amber });
+    else if (savedAt >= 0.0 && ctx.now - savedAt < 4000.0)
+        pills.push_back({ Tr("Settings"), Tr("Saved"), green });
+    else
+        pills.push_back({ Tr("Settings"), Tr("Auto-save on"), grey });
+
+    float x = p.x;
+    float y = p.y + h + 10.0f * s;
+    const float ph = fs + 12.0f * s;
+    const float gap = 8.0f * s;
+    for (const auto& pill : pills)
+    {
+        const ImVec2 ls = font->CalcTextSizeA(fs * 0.92f, FLT_MAX, 0.0f, pill.label);
+        const ImVec2 vs = font->CalcTextSizeA(fs, FLT_MAX, 0.0f, pill.value.c_str());
+        const float pw = 12.0f * s + 8.0f * s + ls.x + 7.0f * s + vs.x + 14.0f * s;
+        if (x + pw > p.x + w && x > p.x)
+        {
+            x = p.x;
+            y += ph + gap;
+        }
+        dl->AddRectFilled(ImVec2(x, y), ImVec2(x + pw, y + ph), pal.pillBg, ph * 0.5f);
+        dl->AddRect(ImVec2(x, y), ImVec2(x + pw, y + ph), pal.pillBorder, ph * 0.5f, 0, 1.2f * s);
+        dl->AddCircleFilled(ImVec2(x + 15.0f * s, y + ph * 0.5f), 4.0f * s, pill.dot);
+        float cx = x + 24.0f * s;
+        dl->AddText(font, fs * 0.92f, ImVec2(cx, y + (ph - ls.y) * 0.5f), pal.pillLabel, pill.label);
+        cx += ls.x + 7.0f * s;
+        dl->AddText(font, fs, ImVec2(cx, y + (ph - vs.y) * 0.5f), pal.pillValue, pill.value.c_str());
+        x += pw + gap;
+    }
+
+    ImGui::SetCursorScreenPos(p);
+    ImGui::Dummy(ImVec2(w, (y + ph) - p.y + 8.0f * s));
+}
