+#pragma once
+
+#include <cstdint>
+
+namespace modulus::graphics
+{
+struct HudCaptureExtent
+{
+    std::uint64_t width = 0;
+    std::uint32_t height = 0;
+};
+
+// HUD capture supplies a full, uncropped scene. Check the physical texture as
+// well as the tagged region: changing metadata cannot resize an old texture.
+inline bool CanSubmitHudCapture(HudCaptureExtent texture, HudCaptureExtent tagged, HudCaptureExtent target)
+{
+    return target.width != 0 && target.height != 0 && texture.width == target.width &&
+           texture.height == target.height && tagged.width == target.width && tagged.height == target.height;
+}
+} // namespace modulus::graphics
