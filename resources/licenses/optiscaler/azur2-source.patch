+void MenuCommon::RenderAzurNavigation(RenderMenuContext& ctx)
+{
+    using namespace azur;
+    const float s = ctx.menuResScale;
+    const bool light = ctx.config->LightTheme.value_or_default();
+    const Palette pal = Pal(light);
+    ImFont* font = ImGui::GetFont();
+    const float fs = ImGui::GetFontSize();
+
+    struct Page
+    {
+        const char* name;
+        const char* desc;
+    };
+    static const Page pages[] = {
+        { "Upscaling", "Upscaler, quality presets and FSR options." },
+        { "Frame Gen", "Frame generation source, output and multiplier. Toggle in game with the FG key." },
+        { "Frame Rate & Latency", "Frame rate limit, latency and the frame time graph." },
+        { "Image Tuning", "Sharpness, mipmap bias, texture filtering and the magnifier." },
+        { "Neural Rendering", "DLSS neural rendering model and strength." },
+        { "Overlay & Look", "FPS overlay, menu theme and colours." },
+        { "Hotkeys", "Menu, overlay, frame generation and NR keys." },
+        { "Advanced", "Inputs, API, quirks and logging. Change only if needed." },
+    };
+    constexpr int pageCount = (int) (sizeof(pages) / sizeof(pages[0]));
+    page = std::clamp(page, 0, pageCount - 1);
+
+    // Left navigation
+    ImGui::PushStyleColor(ImGuiCol_ChildBg, ImVec4(0, 0, 0, 0));
+    ImGui::BeginChild("##azur_nav", ImVec2(kNavWidth * s, kBodyHeight * s), ImGuiChildFlags_None,
+                      ImGuiWindowFlags_NoScrollbar | ImGuiWindowFlags_NoScrollWithMouse);
+    ImDrawList* dl = ImGui::GetWindowDrawList();
+    const float itemH = 50.0f * s;
+    for (int i = 0; i < pageCount; ++i)
+    {
+        ImGui::PushID(i);
+        const ImVec2 a = ImGui::GetCursorScreenPos();
+        const ImVec2 sz(kNavWidth * s - 6.0f * s, itemH);
+        if (ImGui::InvisibleButton("##nav", sz))
+            page = i;
+        const bool hover = ImGui::IsItemHovered();
+        const bool sel = page == i;
+        const ImVec2 b(a.x + sz.x, a.y + sz.y);
+        const float rr = 12.0f * s;
+        if (sel)
+        {
+            dl->AddRectFilled(ImVec2(a.x + 2.0f * s, a.y + 3.0f * s), ImVec2(b.x + 2.0f * s, b.y + 3.0f * s), Col(0.10f, 0.20f, 0.45f, 0.18f), rr);
+            dl->AddRectFilled(a, b, pal.navSel, rr);
+            dl->AddRectFilled(ImVec2(a.x + 3.0f, a.y + 2.0f), ImVec2(b.x - 3.0f, a.y + sz.y * 0.48f), (pal.navSelTop & 0x00FFFFFF) | 0x55000000, rr);
+            dl->AddRect(a, b, pal.gold, rr, 0, 1.5f * s);
+            Star(dl, ImVec2(a.x + 18.0f * s, a.y + sz.y * 0.5f), 7.0f * s, pal.gold);
+            Star(dl, ImVec2(b.x - 16.0f * s, a.y + 12.0f * s), 3.0f * s, Col(1.0f, 1.0f, 1.0f, 0.9f));
+        }
+        else
+        {
+            dl->AddRectFilled(a, b, hover ? pal.navHover : pal.navBg, rr);
+            dl->AddRect(a, b, pal.navBorder, rr, 0, 1.0f);
+            dl->AddCircleFilled(ImVec2(a.x + 18.0f * s, a.y + sz.y * 0.5f), 3.0f * s, (pal.gold & 0x00FFFFFF) | 0xAA000000);
+        }
+        const char* label = Tr(pages[i].name);
+        const ImVec2 ts = font->CalcTextSizeA(fs * 1.08f, FLT_MAX, 0.0f, label);
+        dl->AddText(font, fs * 1.08f, ImVec2(a.x + 34.0f * s, a.y + (sz.y - ts.y) * 0.5f), sel ? pal.navSelText : pal.navText, label);
+        ImGui::Dummy(ImVec2(0.0f, 4.0f * s));
+        ImGui::PopID();
+    }
+    ImGui::EndChild();
+    ImGui::PopStyleColor();
+
+    ImGui::SameLine();
+
+    // Page card
+    ImGui::PushStyleVar(ImGuiStyleVar_ChildRounding, 16.0f * s);
+    ImGui::PushStyleVar(ImGuiStyleVar_WindowPadding, ImVec2(18.0f * s, 14.0f * s));
+    ImGui::BeginChild("##azur_page", ImVec2(kPageWidth * s, kBodyHeight * s), ImGuiChildFlags_Borders | ImGuiChildFlags_AlwaysUseWindowPadding);
+    {
+        ImDrawList* pdl = ImGui::GetWindowDrawList();
+        const ImVec2 tp = ImGui::GetCursorScreenPos();
+        const char* title = Tr(pages[page].name);
+        const ImVec2 tsz = font->CalcTextSizeA(fs * 1.45f, FLT_MAX, 0.0f, title);
+        pdl->AddText(font, fs * 1.45f, tp, pal.pageTitle, title);
+        pdl->AddRectFilled(ImVec2(tp.x, tp.y + tsz.y + 3.0f * s), ImVec2(tp.x + 46.0f * s, tp.y + tsz.y + 6.0f * s), pal.gold, 2.0f * s);
+        Star(pdl, ImVec2(tp.x + tsz.x + 14.0f * s, tp.y + tsz.y * 0.45f), 5.0f * s, pal.gold);
+        ImGui::Dummy(ImVec2(0.0f, tsz.y + 10.0f * s));
+        ImGui::PushStyleColor(ImGuiCol_Text, ImGui::ColorConvertU32ToFloat4(pal.pageDesc));
+        ImGui::TextWrapped("%s", Tr(pages[page].desc));
+        ImGui::PopStyleColor();
+        ImGui::Spacing();
+
+        AzurFlatSections = true;
+        switch (page)
+        {
+        case 0:
+            RenderActiveUpscalerSettings(ctx);
+            RenderFsrCommonSettings(ctx);
+            break;
+        case 1:
+            RenderFrameGenerationSelection(ctx);
+            RenderFrameGenerationRuntimeSettings(ctx);
+            break;
+        case 2:
+            RenderFramerateSettings(ctx);
+#ifdef LOW_LATENCY_INPUTS
+            RenderLowLatencySettings(ctx);
+#else
+            RenderFakenvapiSettings(ctx);
+#endif
+            RenderMainMenuGraphs(ctx);
+            break;
+        case 3:
+            RenderActiveImageSettings(ctx);
+            RenderMagnifierSettings(ctx);
+            break;
+        case 4:
+            DlssNr::RenderMenu(ctx.config, ctx.menuResScale);
+            break;
+        case 5:
+            RenderFpsOverlaySettings(ctx);
+            RenderThemeSettings(ctx);
+            break;
+        case 6:
+            RenderKeybindSettings(ctx);
+            break;
+        default:
+            RenderUpscalerInputsSettings(ctx);
+            RenderApiAndTextureSettings(ctx);
+            RenderQuirksSettings(ctx);
+            RenderAdvancedSettings(ctx);
+            RenderLoggingSettings(ctx);
+            break;
+        }
+        AzurFlatSections = false;
+    }
+    ImGui::EndChild();
+    ImGui::PopStyleVar(2);
+}
